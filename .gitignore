# Track source, documentation, and configuration by default.
# Ignore only generated artifacts, secrets, and machine-local files.

# OS and editor files
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/*.swp
**/*.swo

# Local environment and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.pem
**/*.key
**/*.crt

# Uploaded files of the local storage driver
backend/data/

# Database dumps of the backup service
backend/backups/
**/*.dump

# Build outputs and temporary files
**/bin/
**/tmp/
**/dist/
**/*.test
**/*.out
**/cover.out
**/coverage.html
**/*.zip
**/*.log
**/__debug_bin*

# Agent files
**/.codex
**/.claude/
**/.cursor/
